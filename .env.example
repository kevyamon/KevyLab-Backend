# ==============================================================================
# KEVYLAB BACKEND — MODÈLE DE VARIABLES D'ENVIRONNEMENT
# ==============================================================================
# Ce fichier sert de référence pour configurer l'environnement local et Render.
# Copiez ce fichier vers ".env" en local et complétez les valeurs appropriées.
# ==============================================================================

# --- Configuration du Serveur ---
NODE_ENV=development
PORT=5000

# --- Base de Données MongoDB ---
# Exemple de chaîne de connexion Atlas ou locale
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@cluster0.example.mongodb.net/kevylab?retryWrites=true&w=majority

# --- Sécurité & Authentification JWT Administrateur ---
# Clés secrètes cryptographiques (générez des chaînes aléatoires d'au moins 64 caractères)
JWT_SECRET=remplacez_par_une_cle_secrete_jwt_robuste_et_aleatoire
JWT_REFRESH_SECRET=remplacez_par_une_cle_secrete_refresh_robuste_et_aleatoire

# Durée de validité des jetons
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Inscription Furtive Administrateur (Clé Maître Render) ---
# Clé secrète requise lors de l'enregistrement initial d'un compte administrateur
ADMIN_PW=remplacez_par_le_mot_de_passe_maitre_admin_secret

# --- Service d'Email Transactionnel Brevo ---
# Clé d'API transactionnelle Brevo (v3)
BREVO_API_KEY=votre_cle_api_brevo_v3_ici
BREVO_SENDER_EMAIL=contact@kevylab.com
BREVO_SENDER_NAME=KevyLab

# --- Configuration Réseau & CORS ---
# Origine du client Frontend autorisée (séparer par des virgules si plusieurs)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
